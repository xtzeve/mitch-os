# Flight Control launcher — static assets only (no site shell).
/flight/manifest.webmanifest
  Content-Type: application/manifest+json

/flight
  X-Robots-Tag: noindex, nofollow

/flight/
  X-Robots-Tag: noindex, nofollow

/flight/*
  X-Robots-Tag: noindex, nofollow

# Consider it intro — static HTML, keep out of search.
/considerit
  X-Robots-Tag: noindex, nofollow

/considerit.html
  X-Robots-Tag: noindex, nofollow

# Fördermittel insights intro — static HTML, keep out of search.
/foerdermittel-insights
  X-Robots-Tag: noindex, nofollow

/foerdermittel-insights.html
  X-Robots-Tag: noindex, nofollow
